generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String?   @unique
  phone        String?
  isRegistered Boolean   @default(false)
  avatarUrl    String?
  currency     String    @default("HKD")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  groups        GroupMember[]
  paidExpenses  Expense[]      @relation("PaidExpenses")
  splits        ExpenseSplit[]
  contactsAdded Contact[]      @relation("ContactOwner")
  addedBy       Contact[]      @relation("ContactContact")
  groupInvites  GroupInvite[]  @relation("GroupInviteInviter")
  sentReminders     Reminder[] @relation("ReminderSender")
  receivedReminders Reminder[] @relation("ReminderRecipient")
}

model Group {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  members  GroupMember[]
  expenses Expense[]
  invites  GroupInvite[]
}

model GroupMember {
  id       String   @id @default(uuid())
  role     String   @default("member")
  joinedAt DateTime @default(now())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model Contact {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  ownerId   String
  owner     User   @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactId String
  contact   User   @relation("ContactContact", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactId])
  @@index([contactId])
}

model Expense {
  id        String    @id @default(uuid())
  groupId   String?
  group     Group?    @relation(fields: [groupId], references: [id])
  paidById  String
  paidBy    User      @relation("PaidExpenses", fields: [paidById], references: [id])
  amount    Decimal   @db.Decimal(12, 2)
  currency  String    @default("HKD")
  note      String?
  rate         String?
  rateCurrency String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  splits ExpenseSplit[]

  @@index([groupId])
  @@index([paidById])
}

model ExpenseSplit {
  id        String    @id @default(uuid())
  expenseId String
  expense   Expense   @relation(fields: [expenseId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  amount    Decimal   @db.Decimal(12, 2)
  settledAt DateTime?

  @@unique([expenseId, userId])
  @@index([userId])
}

model GroupInvite {
  id           String    @id @default(uuid())
  email        String
  status       String    @default("pending")
  resolvedAt   DateTime?
  noticeSeenAt DateTime?
  createdAt    DateTime  @default(now())
  groupId      String
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviterId    String
  inviter      User      @relation("GroupInviteInviter", fields: [inviterId], references: [id])

  @@unique([groupId, email])
  @@index([email])
}

model Reminder {
  id        String    @id @default(uuid())
  fromId    String
  toId      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  from User @relation("ReminderSender", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ReminderRecipient", fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId, readAt])
  @@index([fromId, toId])
}
